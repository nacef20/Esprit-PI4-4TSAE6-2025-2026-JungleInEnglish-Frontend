# ===================================================================
# Jungle In English — Frontend .gitignore
# Angular · Tailwind CSS · SCSS · PWA (ngsw)
# ===================================================================

# --------------- Compiled output ---------------
/dist
/tmp
/out-tsc
/bazel-out
/.angular/cache

# --------------- Node / npm / yarn / pnpm ---------------
/node_modules
npm-debug.log
yarn-error.log
yarn-debug.log
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnp.*
pnpm-debug.log*
.npm/

# --------------- Environment & secrets ---------------
*.env
*.env.*
!*.env.example
src/environments/environment.local.ts

# --------------- IDEs and editors ---------------
# IntelliJ / WebStorm
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.project
.classpath
.c9/
*.launch
.settings/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# --------------- Testing & coverage ---------------
/coverage
testem.log
/libpeerconnection.log
/typings
.nyc_output/
junit.xml

# --------------- Build & cache files ---------------
.sass-cache/
/connect.lock
*.tgz

# --------------- PWA / Service Worker ---------------
ngsw-worker.js
ngsw.json

# --------------- OS-generated files ---------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------- Misc ---------------
*.swp
*.swo
*~
.cache/
